// Обновляем название темы и картинку
$('.up-theme').html("<%= @image_data[:theme] %>");
$('.up').html("<%= @image_data[:name] %>");

// Обновляем картинку (убедитесь, что имя файла совпадает с тем, что в seeds)
var pathImage = "/assets/pictures/<%= @image_data[:file] %>";
$(".img-center img").attr("src", pathImage);

// Возвращаем кнопку выбора темы обратно
$('.select_theme').html("<%= j render 'work/theme_from_main' %>");
