= form_with(model: anime_title) do |form|
  - if anime_title.errors.any?
    %div{style: "color: red"}
      %h2= "#{pluralize(anime_title.errors.count, "error")} prohibited this anime_title from being saved:"

      %ul
        - anime_title.errors.each do |error|
          %li= error.full_message

  %div
    = form.label :name, style: "display: block"
    = form.text_field :name

  %div
    = form.label :file, style: "display: block"
    = form.text_field :file

  %div
    = form.label :ave_value, style: "display: block"
    = form.text_field :ave_value

  %div
    = form.label :theme_id, style: "display: block"
    = form.number_field :theme_id

  %div
    = form.submit
