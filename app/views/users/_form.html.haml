= form_with model: @user, local: true, html: { class: "auth-form" } do |f|
  - if @user.errors.any?
    .auth-alert
      %ul.auth-errors
        - @user.errors.full_messages.each do |msg|
          %li= msg

  .auth-field
    = f.label :name, t('users.name'), class: "auth-label"
    = f.text_field :name, class: "auth-input", autofocus: true

  .auth-field
    = f.label :email, t('users.email'), class: "auth-label"
    = f.email_field :email, class: "auth-input", autocomplete: "email"

  .auth-field
    = f.label :password, t('users.password'), class: "auth-label"
    = f.password_field :password, class: "auth-input", autocomplete: "new-password"

  .auth-field
    = f.label :password_confirmation, t('users.password_confirmation'), class: "auth-label"
    = f.password_field :password_confirmation, class: "auth-input", autocomplete: "new-password"

  = f.submit t('users.create_account'), class: "auth-submit"